<file path="css/style_geral.css">
.page-content {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 24px;
    min-height: 100vh;
    overflow-x: hidden;
    background-color: #243b55; /* Fundo escuro padrão */
    color: #ffffff;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

/* Título Principal */
.main-title {
    text-align: left;
    color: #62b6cb; /* Mudado para o ciano padrão das outras telas */
    font-size: 32px;
    font-weight: normal;
    letter-spacing: 1px;
    margin-bottom: 25px;
}
.os-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #e0e0e0;
    padding-bottom: 10px;
    margin-bottom: 25px;
}

.os-header h2 {
    font-size: 1.8rem;
    color: #62b6cb; /* Ciano de destaque */
    margin: 0 0 5px 0;
}

.os-header p {
    color: #9fb3c8;
    margin: 0;
    font-size: 0.95rem;
}

/* Seção de Pesquisa */
.search-fieldset {
    border: 1px solid #334e68;
    border-radius: 4px;
    padding: 15px;
    margin-bottom: 20px;
    width: 100%;
    box-sizing: border-box;
}

.search-fieldset legend {
    padding: 0 10px;
    font-size: 14px;
    color: #9fb3c8;
}

.search-box {
    display: flex;
    align-items: center;
    gap: 15px;
}

.search-box label {
    font-size: 14px;
}

.search-box input[type="text"] {
    background-color: #102a43;
    border: 1px solid #334e68;
    color: white;
    padding: 6px 10px;
    border-radius: 4px;
    width: 200px;
    outline: none;
}

/* Botões Gerais */
.btn {
    padding: 6px 18px;
    border: none;
    border-radius: 3px;
    cursor: pointer;
    font-size: 14px;
    transition: background 0.2s;
}

.btn-blue { background-color: #486581; color: white; }
.btn-blue:hover { background-color: #627d98; }

.btn-orange { background-color: #f0ad4e; color: white; }
.btn-orange:hover { background-color:#f8a838; }

.btn-cyan { background-color: #2cb1bc; color: #102a43; font-weight: 500; }
.btn-cyan:hover { background-color: #4ed0dc; }

.btn-red { background-color: #d9534f; color: white; }
.btn-red:hover { background-color: #e66d6a; }

.btn-light-blue { background-color: #3b82f6; color: white; }
.btn-light-blue:hover { background-color: #60a5fa; }

/* Badges de Status na Tabela */
.badge {
    padding: 3px 8px;
    border-radius: 12px;
    font-size: 11px;
    text-transform: uppercase;
    font-weight: bold;
}
.badge-aberto { background-color: #f0ad4e; color: #fff; }
.badge-aprovado { background-color: #5cb85c; color: #fff; }
.badge-reprovado { background-color: #d9534f; color: #fff; }
.badge-finalizado { background-color: #0275d8; color: #fff; }

.btn-sucesso {
    background-color: #28a745;
    color: white;
    border: none;
    padding: 10px 15px;
    border-radius: 4px;
    cursor: pointer;
    font-weight: bold;
}

.btn-sucesso:hover { background-color: #218838; }

.section-card {
    background-color: #1a304a;
    border-radius: 6px;
    padding: 20px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.15);
}

.section-card h3 {
    margin: 0 0 15px 0;
    font-size: 1.1rem;
    color: #62b6cb;
}

/* Container da tabela fluído */
.table-container {
    border: 1px solid #486581 !important;
    border-radius: 4px;
    background-color: #1a304a;
    overflow-x: auto;
    margin-bottom: 25px;
    width: 100%;
    flex-grow: 1;
}

.os-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 13px;
}

.os-table th {
    background-color: #334e68;
    color: #ffffff;
    padding: 12px;
    font-weight: 500;
    border-bottom: 2px solid #486581;
}

.os-table td {
    padding: 12px;
    border-bottom: 1px solid #243b53;
    color: #e2e8f0;
}

.os-table tbody tr:hover td {
    background-color: #243b53;
}

.footer-actions {
    display: flex;
    justify-content: right;
    gap: 15px;
    width: 100%;
    margin-top: auto;
    padding: 10px;
}

.modal-overlay {
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0, 0, 0, 0.7);
    display: none; /* Iniciará escondido */
    justify-content: center;
    align-items: center;
    z-index: 9999;
}

.modal-content {
    background-color: #1a304a;
    border: 2px solid #486581;
    border-radius: 6px;
    padding: 25px;
    width: 90%;
    max-width: 400px;
    text-align: center;
    box-shadow: 0 4px 20px rgba(0,0,0,0.5);
}

.modal-content h3 {
    color: #62b6cb;
    margin-bottom: 15px;
    font-weight: normal;
    margin-top: 0;
}

.modal-content p {
    color: #ffffff;
    font-size: 14px;
    margin-bottom: 25px;
    line-height: 1.5;
}

.modal-buttons {
    display: flex;
    justify-content: center;
    gap: 15px;
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.form-group label {
    font-size: 13px;
    color: #9fb3c8;
}

.form-group input[type="text"],
.form-group input[type="number"],
.form-group select,
.form-group textarea {
    background-color: #102a43;
    border: 1px solid #334e68;
    color: white;
    padding: 8px 10px;
    border-radius: 4px;
    outline: none;
    font-family: inherit;
    font-size: 14px;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
    border-color: #2cb1bc;
}
</file>

